void main() {
  // Book objects and discount calculation
  final book1 = Book('The Alchemist', 'Paulo Coelho', 500.0);
  final book2 = Book('Clean Code', 'Robert C. Martin', 850.0);

  print('========== BOOK DETAILS ==========');
  book1.displayDetails();
  print('Price after 10% discount: ${book1.discountedPrice(10).toStringAsFixed(2)}');
  print('');
  book2.displayDetails();
  print('Price after 15% discount: ${book2.discountedPrice(15).toStringAsFixed(2)}');

  //Inheritance: Manager and Developer
  final manager = Manager('Rahim', 80000.0, 'Human Resources');
  final developer = Developer('Karim', 65000.0, 'Dart');

  print('\n========== EMPLOYEE DETAILS ==========');
  manager.displayInformation();
  print('');
  developer.displayInformation();

  // Abstraction: Fan and Light
  Appliance fan = Fan();
  Appliance light = Light();

  print('\n========== APPLIANCE DETAILS ==========');
  fan.turnOn();
  fan.turnOff();
  light.turnOn();
  light.turnOff();
}

//Book class
class Book {
  final String title;
  final String author;
  final double price;

  // Constructor
  Book(this.title, this.author, this.price);

  // Returns price after discount
  double discountedPrice(double discountPercent) {
    return price - (price * discountPercent / 100);
  }

  void displayDetails() {
    print('Title: $title');
    print('Author: $author');
    print('Price: ${price.toStringAsFixed(2)}');
  }
}

// Base class
class Employee {
  final String name;
  final double salary;

  Employee(this.name, this.salary);
}

// Manager inherits Employee
class Manager extends Employee {
  final String department;

  Manager(String name, double salary, this.department) : super(name, salary);

  void displayInformation() {
    print('Employee Type: Manager');
    print('Name: $name');
    print('Salary: ${salary.toStringAsFixed(2)}');
    print('Department: $department');
  }
}

// Developer inherits Employee
class Developer extends Employee {
  final String programmingLanguage;

  Developer(String name, double salary, this.programmingLanguage)
      : super(name, salary);

  void displayInformation() {
    print('Employee Type: Developer');
    print('Name: $name');
    print('Salary: ${salary.toStringAsFixed(2)}');
    print('Programming Language: $programmingLanguage');
  }
}

// Abstract class
abstract class Appliance {
  void turnOn();
  void turnOff();
}

class Fan extends Appliance {
  @override
  void turnOn() {
    print('Fan is now running.');
  }

  @override
  void turnOff() {
    print('Fan is now stopped.');
  }
}

class Light extends Appliance {
  @override
  void turnOn() {
    print('Light is switched on.');
  }

  @override
  void turnOff() {
    print('Light is switched off.');
  }

}
